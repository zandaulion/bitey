node_modules/
data/
.env
*.log

# Competitive positioning and commercial thinking. This repo is public, and
# that analysis helps a competitor more than it helps a contributor. It travels
# to the laptop by another route.
docs/
tools/

# Android Studio and Gradle outputs for the native, local-first client.
# The wrapper under android/gradle/ is deliberately not here: it pins the
# Gradle version and has to travel with the repository.
android/.gradle/
android/.idea/
android/.kotlin/
android/build/
android/app/build/
android/local.properties
android/keystore.properties
android/app/*.jks
android/app/*.keystore

# Signed upload bundles are local release artifacts. Keep them in store/releases
# for Play Console upload, but never publish a signed binary by accident.
store/releases/*.aab
store/releases/*.apks
# Android Studio's Generate Signed Bundle wizard writes here by default.
android/app/release/

# A Gradle distribution unpacked by a wrapper run with GRADLE_USER_HOME pointed
# at android/. Only android/gradle/wrapper/ travels with the repository.
android/wrapper/

# Locally copied APKs can contain release artefacts and are not source or
# Play listing material. Keep them on the machine, outside the public repo.
APKs/
*.apk

# Future Firebase project material belongs in the deployment environment, not
# in the public source repository. (The Android config itself is not a secret,
# but is kept local under Bitey's no-personal-project-details rule.)
android/app/google-services.json
# App Check debug secret for a test device. Whoever holds it passes App Check,
# so it lives next to the build, never in the repository.
android/appcheck-debug-token.txt
firebase-service-account*.json
service-account*.json
functions/.env*
# The Firebase CLI's deploy cache and emulator state.
.firebase/
firebase-debug*.log
firestore-debug*.log
