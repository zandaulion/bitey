<?xml version="1.0" encoding="utf-8"?>
<!-- The Today widget at two rows or more: what has been eaten against what is
     burned, its split by macro with a legend, and the three ways to log. The
     buttons keep a fixed height; spare height goes above them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="3dp">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_name"
            android:textColor="@color/widget_muted"
            android:textSize="13sp"
            android:textStyle="bold" />
        <!-- "601 of ~1881 kcal", the number drawn large by TodayWidget. -->
        <TextView
            android:id="@+id/widget_kcal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_empty"
            android:textColor="@color/widget_muted"
            android:textSize="15sp" />
        <ImageView
            android:id="@+id/widget_bar"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="6dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />
        <TextView
            android:id="@+id/widget_macros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Large sizes only (TodayWidget shows it from about three rows): Bitey,
         in the mood the app last drew, with his macro advice. -->
    <LinearLayout
        android:id="@+id/widget_advice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <ImageView
            android:id="@+id/widget_bitey"
            android:layout_width="72dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
        <TextView
            android:id="@+id/widget_advice_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_speech"
            android:ellipsize="end"
            android:maxLines="5"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- A FrameLayout, not a View: widgets refuse plain View. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="8dp" />

    <LinearLayout
        android:id="@+id/widget_buttons"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/widget_photo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_button_primary"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_action_photo"
                android:tint="@color/widget_accent_ink" />
            <TextView
                android:id="@+id/widget_photo_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_photo"
                android:textColor="@color/widget_accent_ink"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_barcode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_action_barcode"
                android:tint="@color/widget_ink" />
            <TextView
                android:id="@+id/widget_barcode_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_barcode"
                android:textColor="@color/widget_ink"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_manual"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_action_manual"
                android:tint="@color/widget_ink" />
            <TextView
                android:id="@+id/widget_manual_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_manual"
                android:textColor="@color/widget_ink"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
