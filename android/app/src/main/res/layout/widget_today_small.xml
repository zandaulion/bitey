<?xml version="1.0" encoding="utf-8"?>
<!-- The Today widget at one row: the three ways to log, nothing else. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="6dp">
    <LinearLayout
        android:id="@+id/widget_buttons"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/widget_photo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_button_primary"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_action_photo"
                android:tint="@color/widget_accent_ink" />
            <TextView
                android:id="@+id/widget_photo_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_photo"
                android:textColor="@color/widget_accent_ink"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_barcode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_action_barcode"
                android:tint="@color/widget_ink" />
            <TextView
                android:id="@+id/widget_barcode_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_barcode"
                android:textColor="@color/widget_ink"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_manual"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_action_manual"
                android:tint="@color/widget_ink" />
            <TextView
                android:id="@+id/widget_manual_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_manual"
                android:textColor="@color/widget_ink"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
