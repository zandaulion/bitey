# Copy this file to android/keystore.properties on this computer only.
# That file is ignored by Git. Never commit passwords or the keystore itself.
#
# It must sit next to android/settings.gradle.kts, because that folder is the
# root of this Gradle build. A copy left in the repository root is not read.
#
# storeFile is resolved against that same android/ folder, so the relative path
# below means <repo>/../globe-release.jks. An absolute path is also accepted and
# is the surer option if the keystore lives elsewhere; on Windows write it with
# forward slashes, e.g. C:/Users/you/keys/globe-release.jks
storeFile=../../globe-release.jks
storePassword=REPLACE_WITH_LOCAL_STORE_PASSWORD
keyAlias=REPLACE_WITH_LOCAL_KEY_ALIAS
keyPassword=REPLACE_WITH_LOCAL_KEY_PASSWORD
