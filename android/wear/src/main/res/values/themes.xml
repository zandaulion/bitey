<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Bitey" parent="@android:style/Theme.DeviceDefault" />

    <!-- The launch screen Wear's app quality guidelines ask for: the icon on
         black. Wear OS 3 has no system splash screen, so without this the
         watch showed an empty black window until the first frame. -->
    <style name="Theme.Bitey.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Bitey</item>
    </style>
</resources>
