rules_version = '2';

// Nothing here is client-readable.
//
// The only collection is ai_usage: one counter per subscription per day,
// written by the analyse function through the Admin SDK, which bypasses these
// rules entirely. No Bitey client authenticates to Firestore, so any request
// that reaches these rules is one that should not exist.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
